{
  "name": "the-itinerists",
  "version": "0.9.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/set-version.js",
    "start": "ng serve",
    "build": "node scripts/set-version.js && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node test/firestore-rules.test.mjs && node test/storage-rules.test.mjs\"",
    "test:pulse": "node --test test/pulse-stats.test.mjs",
    "sync-seed": "node scripts/sync-seed.js",
    "gen-env": "node scripts/gen-env.js",
    "start:demo": "ng serve --configuration demo --port 4400",
    "build:demo": "node scripts/set-version.js && ng build --configuration demo",
    "deploy:demo": "npm run build:demo && firebase deploy --only hosting:the-itinerists-demo",
    "ios:sync": "node scripts/set-version.js --ios && npm run build && npx cap sync ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "ios:open": "npx cap open ios",
    "test:rules:storage": "firebase emulators:exec --only storage \"node test/storage-rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:staging": "node scripts/set-version.js && ng build --configuration staging",
    "deploy:staging": "npm run build:staging && firebase deploy --project staging --only hosting:the-itinerists-staging,firestore:rules,firestore:indexes"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.0",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.1.0",
    "@angular/platform-browser": "^19.1.0",
    "@angular/platform-browser-dynamic": "^19.1.0",
    "@angular/pwa": "^19.2.27",
    "@angular/router": "^19.1.0",
    "@angular/service-worker": "^19.2.25",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@types/leaflet": "^1.9.21",
    "firebase": "^12.9.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tz-lookup": "^6.1.25",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.4",
    "@angular/cli": "^19.1.4",
    "@angular/compiler-cli": "^19.1.0",
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "@vvo/tzdb": "^6.198.0",
    "firebase-admin": "^13.7.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2"
  }
}
