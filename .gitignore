# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Firebase cache
.firebase/

# Claude local settings
.claude/settings.local.json

# Superpowers tooling cache
.superpowers/

# Secrets and local environment config (never commit)
.env
scripts/serviceAccountKey.json

# Generated environment files (built from .env via: npm run gen-env)
src/environments/environment.ts
src/environments/environment.prod.ts
public/pulse/config.mjs

# Generated version stamp (scripts/set-version.js — runs on npm install and build)
src/version.ts

# Firebase emulator logs
firestore-debug.log
ui-debug.log
firebase-debug.log

# Design Phase 2 — heavy reference assets kept locally (originals in the export zip)
docs/design-phase-2/_original-export.zip
docs/design-phase-2/uploads/

# Local-only admin scripts: they read production user data, never publish them
scripts/stats.js

# Local-only test credentials written by scripts/create-test-member.js
scripts/*.local.*

# Capacitor iOS shell: generated per sync/build, never committed
ios/App/App/public
ios/App/App/capacitor.config.json
ios/App/build
ios/App/**/xcuserdata
ios/App/**/DerivedData
ios/App/Pods
ios/App/Podfile.lock

# Firebase iOS config (fetched by: node scripts/fetch-ios-config.js)
ios/App/App/GoogleService-Info.plist

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Service account keys (production and staging)
scripts/serviceAccountKey*.json

# Git worktrees for parallel work (see AGENTS.md 2.2)
.worktrees/

# Saved staging test sessions (live tokens)
e2e-staging/.auth/
