rules_version = '2';

// Trip Planner security rules (TP-9).
//
// Access model:
//   • Trip data is readable/writable only by *members* of that trip (a member
//     is a doc at trips/{tripId}/members/{uid}).
//   • Privileged member actions (role changes, removing others) are owner-only.
//   • Per-user docs (users, userTrips) are self-owned; app admins may also touch
//     them for member management.
//
// Deliberate public-read exceptions, forced by the invite/register flow, which
// runs *before* the Firebase Auth account exists (see AuthService.register):
//   • inviteIndex/{code}            — resolve an invite code → tripId
//   • trips/{tripId}/invites/{code} — validate the invite before joining
//   • users                         — username-uniqueness check
// These expose only low-sensitivity data (codes you must already know, and
// public profile fields). Credentials live in Firebase Auth, never Firestore.
//
// Known relaxation (documented follow-up): a signed-in user can self-create
// their own trips/{tripId}/members/{uid} doc, so membership isn't cryptographically
// gated on holding a valid invite — it relies on tripIds being unguessable random
// ids. True enforcement would move join to a server-side callable. Tracked for later.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isMember(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(uid()));
    }
    function isOwner(tripId) {
      return isMember(tripId)
        && get(/databases/$(database)/documents/trips/$(tripId)/members/$(uid())).data.role == 'owner';
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true;
    }

    // ── App logs: write-only from the client (unchanged) ───────────────────
    match /_appLogs/{log} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── User profiles ──────────────────────────────────────────────────────
    // Public read: registration checks username uniqueness while unauthenticated,
    // and members render each other's name/avatar. Only public profile fields
    // live here. You may write only your own doc; admins may also edit (disable).
    match /users/{userId} {
      allow read:   if true;
      // You may create only your own doc, and NOT pre-set privileged fields.
      allow create: if isSignedIn() && userId == uid()
                 && request.resource.data.get('isAdmin', false) == false
                 && request.resource.data.get('isDisabled', false) == false;
      // You may edit your own profile but NOT the privileged fields (isAdmin,
      // isDisabled) — that would be self-escalation. Admins may edit anything.
      allow update: if isAdmin()
                 || (userId == uid()
                     && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                     && request.resource.data.get('isDisabled', false) == resource.data.get('isDisabled', false));
      allow delete: if userId == uid() || isAdmin();
    }

    // ── Per-user trip index ────────────────────────────────────────────────
    // Your own list of trips. Admins may edit it too, because removing a member
    // updates the removed user's index (TripService.removeMember).
    match /userTrips/{userId} {
      allow read:  if userId == uid();
      allow write: if userId == uid() || isAdmin();
    }

    // ── Global invite lookup ───────────────────────────────────────────────
    // Public read so an invite code resolves to a trip before sign-in. Written
    // by a signed-in member when generating/rescinding an invite.
    match /inviteIndex/{code} {
      allow read:  if true;
      allow write: if isSignedIn();
    }

    // ── Shared geocode cache (non-sensitive, any signed-in user) ────────────
    match /geocache/{doc} {
      allow read, write: if isSignedIn();
    }

    // ── Per-user "My Expenses" — private to the owner ──────────────────────
    // Keyed by uid; only the signed-in owner may read/write (same pattern as
    // userTrips). The shared trip finance lives at trips/{tripId}/finance.
    match /userExpenses/{userId} {
      allow read, write: if isSignedIn() && userId == uid();
    }

    // ── Trips and their sub-collections ────────────────────────────────────
    match /trips/{tripId} {
      allow read:   if isMember(tripId);
      allow create: if isSignedIn() && request.resource.data.createdBy == uid();
      // Members maintain shared trip fields (memberCount, dates, ownership
      // transfer). Deletion happens when the last member leaves (purge).
      allow update, delete: if isMember(tripId);

      // Members: owners manage roles/removal; you can add or remove *yourself*
      // (self-join via invite, self-leave).
      match /members/{memberId} {
        allow read:   if isMember(tripId);
        // Self-join is allowed only as a plain 'member' — you can't make yourself
        // an owner. The one exception is the trip's creator seeding themselves as
        // the initial owner. Existing owners/admins may add anyone in any role.
        allow create: if isSignedIn() && (
                         isOwner(tripId) || isAdmin()
                         || (memberId == uid() && request.resource.data.role == 'member')
                         || (memberId == uid() && request.resource.data.role == 'owner'
                             && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == uid())
                       );
        // Owners/admins manage roles; you may edit your own member doc but NOT
        // change your own role (no self-promotion to owner).
        allow update: if isOwner(tripId) || isAdmin()
                   || (memberId == uid() && request.resource.data.role == resource.data.role);
        allow delete: if memberId == uid() || isOwner(tripId) || isAdmin();
      }

      // Invites: public read (pre-auth join resolves the code); members manage.
      match /invites/{code} {
        allow read:   if true;
        // Only the trip's owner (or an app admin) can mint or revoke invites.
        allow create, delete: if isOwner(tripId) || isAdmin();
        // A person who just joined stamps themselves onto usedBy.
        allow update: if isMember(tripId);
      }

      // Outfit photos: PRIVATE to the uploader. A trip member can read/write
      // only their own photos (doc carries ownerUid); other members and
      // outsiders get nothing. Kept out of the shared {sub}/{doc} allowlist
      // below so this stricter rule is the only grant.
      match /outfitPhotos/{photoId} {
        allow read:   if isMember(tripId) && resource.data.ownerUid == uid();
        allow create: if isMember(tripId) && request.resource.data.ownerUid == uid();
        allow update: if isMember(tripId) && resource.data.ownerUid == uid()
                                          && request.resource.data.ownerUid == uid();
        allow delete: if isMember(tripId) && resource.data.ownerUid == uid();
      }

      // Collaborative + per-user trip data. Enumerated so the wildcard can't
      // over-grant on the members/invites sub-collections above.
      match /{sub}/{doc} {
        allow read, write: if isMember(tripId) && sub in [
          'itinerary', 'finance', 'stays', 'recs', 'cars', 'pins',
          'flights', 'outfits', 'dayLabels', 'packing', 'packingSuggestions',
          'activityLog'
        ];
      }
    }

    // Everything else is denied by default (no catch-all allow).
  }
}
