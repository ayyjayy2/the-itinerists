rules_version = '2';

// Trip Planner security rules (TP-9).
//
// Access model:
//   • Trip data is readable/writable only by *members* of that trip (a member
//     is a doc at trips/{tripId}/members/{uid}).
//   • Privileged member actions (role changes, removing others) are owner-only.
//   • Per-user docs (users, userTrips) are self-owned; app admins may also touch
//     them for member management.
//
// Deliberate public-read exceptions, forced by the invite/register flow, which
// runs *before* the Firebase Auth account exists (see AuthService.register):
//   • inviteIndex/{code}            — resolve an invite code → tripId
//   • trips/{tripId}/invites/{code} — validate the invite before joining
//   • usernames/{username}          — username → placeholder sign-in address, single-doc GET only
// These expose only low-sensitivity data (codes you must already know, and an
// old account's placeholder address; never a real email). Each is a
// single-document GET: none of them can be listed by an outsider, and user profiles can never be listed except by
// an app admin. Credentials live in Firebase Auth, never Firestore.
//
// Self-join is gated on a live invite: the member doc must name an invite code
// that exists under the trip and has not expired (see joinsWithLiveInvite), so
// knowing a trip id is not enough to join it.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    // Sessions last 90 days from when the person last entered their password
    // (auth_time, in seconds). After that every request is refused until they
    // sign in again; the app signs them out first and says why (utils/session.ts).
    // uid() carries the check too, so rules that compare it directly are covered.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 90 * 24 * 60 * 60 * 1000;
    }
    function uid() {
      return isSignedIn() ? request.auth.uid : null;
    }
    function isMember(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(uid()));
    }
    function isOwner(tripId) {
      return isMember(tripId)
        && get(/databases/$(database)/documents/trips/$(tripId)/members/$(uid())).data.role == 'owner';
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true;
    }
    // The app owner and nobody else: the only account that can read Pulse's
    // data (_activity, _writes, _pulse) and every trip's summary doc. It is
    // the `owner` custom claim, which only scripts/set-account-flags.js (admin
    // SDK) can grant; being an admin does NOT grant it. Never give the claim
    // to another account without the owner's explicit permission.
    function isAppOwner() {
      return isSignedIn() && request.auth.token.get('owner', false) == true;
    }
    // A self-join must carry the invite code it came from, and that invite
    // must exist under the trip and still be valid. This is what makes
    // membership depend on holding an invite rather than on guessing a trip id.
    function joinsWithLiveInvite(tripId, data) {
      return data.keys().hasAll(['inviteCode'])
        && data.inviteCode is string
        && exists(/databases/$(database)/documents/trips/$(tripId)/invites/$(data.inviteCode))
        && get(/databases/$(database)/documents/trips/$(tripId)/invites/$(data.inviteCode)).data.expiresAt > request.time.toMillis();
    }

    // Per-account limits: how many of each kind one account may add in a
    // rolling 24-hour window. Keep in step with QUOTA_LIMITS in
    // src/app/utils/quota.ts (the app checks first so it can say so kindly).
    function quotaLimits() {
      return { 'photos': 50, 'trips': 20 };
    }
    // A limited write (an outfit photo, a new trip) must bump its counter in
    // the same batch: the counter's `at` is this request's time.
    function countsAgainstQuota(kind) {
      return getAfter(/databases/$(database)/documents/_quotas/$(uid())/kinds/$(kind)).data.at == request.time;
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // ── App logs: write-only from the client ───────────────────────────────
    // Errors can happen before sign-in, so anyone using the app (App Check)
    // may write one, but only in the logger's shape and size: a log can't be
    // used to store arbitrary data.
    match /_appLogs/{log} {
      allow create: if request.resource.data.keys().hasOnly(['timestamp', 'type', 'message', 'stack', 'url', 'sessionId'])
        && request.resource.data.type in ['js_error', 'http_error', 'firebase_error', 'write_spike', 'csp_violation', 'diagnostic']
        && shortString(request.resource.data.message, 2000)
        && shortString(request.resource.data.get('stack', ''), 600)
        && shortString(request.resource.data.url, 500)
        && shortString(request.resource.data.sessionId, 64)
        && shortString(request.resource.data.timestamp, 40);
      allow read, update, delete: if false;
    }

    // ── Launch list: "Notify me" on the welcome page (signed out is fine) ──
    // Add-only: an email, which list, and the server's time. Nobody can change
    // or delete an entry from the app. Only the app owner can read it (Pulse
    // shows the count, never the emails); the list itself comes out with
    // scripts/waitlist.js (Admin SDK). App Check keeps writes to the real app.
    match /_waitlist/{entry} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'list', 'at'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.list in ['ios']
        && request.resource.data.at == request.time;
      allow read: if isAppOwner();
      allow update, delete: if false;
    }

    // ── Usage events: append-only by the signed-in user, read by the owner ─
    // One doc per page view / session / ping (see UsageService). A user may
    // only record events as themselves, with exactly the expected fields and
    // a server timestamp, and nothing is ever edited or deleted from the app.
    match /_activity/{event} {
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly([
             'uid', 'tripId', 'type', 'page', 'at', 'localHour', 'tz',
             'tzOffsetMin', 'platform', 'sessionId', 'appVersion', 'offer'])
        && request.resource.data.type in ['session', 'page', 'ping', 'offer']
        // A partner-offer tap (#474) names the partner, and only that kind of event does.
        && (request.resource.data.type == 'offer'
              ? request.resource.data.get('offer', '').matches('^[a-z0-9-]{1,32}$')
              : !('offer' in request.resource.data))
        && shortString(request.resource.data.page, 200)
        && (request.resource.data.get('tripId', null) == null || shortString(request.resource.data.tripId, 64))
        && shortString(request.resource.data.get('tz', ''), 64)
        && shortString(request.resource.data.get('platform', ''), 20)
        && shortString(request.resource.data.get('sessionId', ''), 64)
        && shortString(request.resource.data.get('appVersion', ''), 40)
        && request.resource.data.at == request.time;
      allow read: if isAppOwner();
      allow update, delete: if false;
    }

    // ── Write log: one doc per change a person makes (kind + action only, no
    // content), appended by the signed-in user as themselves, read by the owner.
    // Pulse charts "things written per day" from it (see TripEventsService).
    match /_writes/{entry} {
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'tripId', 'kind', 'action', 'at'])
        && request.resource.data.kind in ['itinerary', 'flight', 'stay', 'transport', 'finance', 'rec', 'pin', 'packing', 'member', 'trip']
        && shortString(request.resource.data.action, 40)
        && (request.resource.data.get('tripId', null) == null || shortString(request.resource.data.tripId, 64))
        && request.resource.data.at == request.time;
      allow read: if isAppOwner();
      allow update, delete: if false;
    }

    // ── Pulse dashboard preferences: the owner's own, e.g. hidden test trips ─
    match /_pulse/{docId} {
      allow read, write: if isAppOwner();
    }

    // ── App settings: _config/{name} ───────────────────────────────────────
    // `survey`: the survey invitation shown on Home (SurveyConfig). Any
    // signed-in person reads it; only scripts/set-survey.js (Admin SDK) writes.
    match /_config/{docId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ── API console (staging only, /api-console/): who may use it, and its spec ─
    // An account is approved when _apiConsoleAccess/{uid} exists. Only the owner
    // grants it, with scripts/api-console.js (Admin SDK); the app can never write
    // either collection. The spec is readable by approved accounts alone.
    match /_apiConsoleAccess/{userId} {
      allow get: if isSignedIn() && userId == uid();
      allow list, write: if false;
    }
    match /_apiConsole/{docId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/_apiConsoleAccess/$(uid()));
      allow write: if false;
    }

    // ── Account deletions: _deletions/{uid} (#452) ─────────────────────────
    // Written by the account itself as it deletes itself, read only in Pulse:
    // when, when the account was made, how many trips, when the last ended.
    // No name, email or content. One per account, never changed.
    match /_deletions/{userId} {
      allow create: if isSignedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'accountCreatedAt', 'trips', 'lastTripEnd', 'test'])
        && request.resource.data.uid == uid()
        && request.resource.data.at == request.time
        && request.resource.data.accountCreatedAt is int
        && request.resource.data.trips is int && request.resource.data.trips >= 0
        && (request.resource.data.lastTripEnd == null
            || (request.resource.data.lastTripEnd is string && request.resource.data.lastTripEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.test is bool;
      allow read: if isAppOwner();
      allow update, delete: if false;
    }

    // ── Per-account limits: _quotas/{uid}/kinds/{kind} ───────────────────────
    // { windowStart, count, at }: how many of a kind this account has added
    // since windowStart. The counter only ever goes up by one, or starts over
    // once 24 hours have passed, so it can't be reset early; writing it on
    // its own just uses up the allowance. No content, only a count.
    match /_quotas/{userId}/kinds/{kind} {
      allow read: if isSignedIn() && userId == uid();
      allow create: if isSignedIn() && userId == uid()
        && kind in quotaLimits()
        && request.resource.data.keys().hasOnly(['windowStart', 'count', 'at'])
        && request.resource.data.windowStart == request.time
        && request.resource.data.at == request.time
        && request.resource.data.count == 1;
      allow update: if isSignedIn() && userId == uid()
        && kind in quotaLimits()
        && request.resource.data.keys().hasOnly(['windowStart', 'count', 'at'])
        && request.resource.data.at == request.time
        && ((request.time >= resource.data.windowStart + duration.value(1, 'd')
             && request.resource.data.windowStart == request.time
             && request.resource.data.count == 1)
          || (request.time < resource.data.windowStart + duration.value(1, 'd')
             && request.resource.data.windowStart == resource.data.windowStart
             && request.resource.data.count == resource.data.count + 1
             && request.resource.data.count <= quotaLimits()[kind]));
      // Deleting your account clears a counter whose window has passed.
      allow delete: if isSignedIn() && userId == uid()
        && request.time >= resource.data.windowStart + duration.value(1, 'd');
    }

    // ── User profiles ──────────────────────────────────────────────────────
    // Profile fields only (name, username, avatar, preferences) — never an
    // email address; those live in users/{uid}/private. Only the person and
    // app admins can read a profile; nobody else, and nobody can list users.
    // What members see of each other (name, avatar) is copied onto the trip's
    // own member records, so no one ever needs another person's profile.
    // You may write only your own doc; admins may also edit (disable).
    // A real, deliverable address: email-shaped and not the old placeholder
    // domain (username@the-itinerists.local), which can't receive mail.
    function isRealEmail(e) {
      return e is string
        && e.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && !e.lower().matches('.*@the-itinerists[.]local$');
    }
    // Every new account signs up with a real email: the signed-in account itself carries one.
    function signedUpWithEmail() {
      return isRealEmail(request.auth.token.get('email', ''));
    }
    function hasNoEmailFields(data) {
      return !('authEmail' in data) && !('pendingEmail' in data);
    }
    match /users/{userId} {
      allow get:  if isSignedIn() && (userId == uid() || isAdmin());
      allow list: if isAdmin();
      // You may create only your own doc, and NOT pre-set privileged fields.
      allow create: if isSignedIn() && userId == uid()
                 && signedUpWithEmail()
                 && hasNoEmailFields(request.resource.data)
                 && request.resource.data.get('isAdmin', false) == false
                 && request.resource.data.get('isDisabled', false) == false
                 && request.resource.data.get('layoutPicker', false) == false;
      // You may edit your own profile but NOT the privileged fields (isAdmin,
      // isDisabled, layoutPicker) — that would be self-escalation. Admins may edit anything.
      allow update: if isAdmin()
                 || (userId == uid()
                     && hasNoEmailFields(request.resource.data)
                     && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                     && request.resource.data.get('isDisabled', false) == resource.data.get('isDisabled', false)
                     && request.resource.data.get('layoutPicker', false) == resource.data.get('layoutPicker', false));
      allow delete: if userId == uid() || isAdmin();

      // Private account data (sign-in email, pending recovery email): the
      // person themselves and app admins only.
      match /private/{docId} {
        allow read, write: if userId == uid() || isAdmin();
      }
    }

    // ── Username index ─────────────────────────────────────────────────────
    // usernames/{username} → { uid, authEmail? }, only for accounts made before
    // sign-up asked for an email: they sign in with their username, which maps
    // to a placeholder address (username@the-itinerists.local). Sign-in reads a
    // single document before the user is authenticated, so anyone who knows a
    // username may fetch it; the collection can never be listed. It must never
    // hold a real address (#352): everyone else signs in with their email, and
    // their entry (if any) carries only the uid, so sign-in can say so.
    // No new names are claimed; an entry's owner may only drop its address.
    function isPlaceholderAddress(e) {
      return e is string && e.lower().matches('.*@the-itinerists[.]local$');
    }
    function isUsernameEntry(data) {
      return data.keys().hasOnly(['uid', 'authEmail'])
        && (!('authEmail' in data) || isPlaceholderAddress(data.authEmail));
    }
    match /usernames/{username} {
      allow get:    if true;
      allow list:   if false;
      allow create: if false;
      allow update: if isSignedIn() && (isAdmin() || resource.data.uid == uid())
                 && request.resource.data.uid == resource.data.uid
                 && isUsernameEntry(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
    }

    // ── Per-user trip index ────────────────────────────────────────────────
    // Your own list of trips. Admins may edit it too, because removing a member
    // updates the removed user's index (TripService.removeMember).
    match /userTrips/{userId} {
      allow read:  if userId == uid();
      allow write: if userId == uid() || isAdmin();
    }

    // ── Global invite lookup ───────────────────────────────────────────────
    // A single code resolves to its trip before sign-in (GET only: listing
    // would hand out every live code). Only the trip's owner (or an app admin)
    // may publish a code, and only for an invite that exists under that trip;
    // only they may remove it. Entries are never edited.
    match /inviteIndex/{code} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'expiresAt'])
        && request.resource.data.tripId is string
        && (isOwner(request.resource.data.tripId) || isAdmin())
        && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)/invites/$(code));
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource == null || isOwner(resource.data.tripId) || isAdmin());
    }

    // The old shared place cache held every trip's place names, readable by any
    // signed-in account (#356). Closed: each trip keeps its own (below).
    match /geocache/{docId} {
      allow read, write: if false;
    }

    // ── Per-user "My Expenses" — private to the owner ──────────────────────
    // Keyed by uid; only the signed-in owner may read/write (same pattern as
    // userTrips). The shared trip finance lives at trips/{tripId}/finance.
    match /userExpenses/{userId} {
      allow read, write: if isSignedIn() && userId == uid();
    }

    // ── Trips and their sub-collections ────────────────────────────────────
    match /trips/{tripId} {
      // Members read their trip; the app owner may also read (and list) every
      // trip's summary doc and its members for the usage dashboard — nothing
      // else under the trip, and no writes.
      allow read:   if isMember(tripId) || isAppOwner();
      // A new trip counts against the creator's daily allowance.
      allow create: if isSignedIn() && request.resource.data.createdBy == uid()
                    && countsAgainstQuota('trips');
      // Members maintain shared trip fields (memberCount, dates, name). Only
      // the owner may change createdBy (ownership transfer): it is what lets
      // someone seed themselves as owner, so a member must never set it.
      allow update: if isOwner(tripId)
                    || (isMember(tripId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'id']));
      // Deletion is the purge when the last member (always the owner) leaves.
      allow delete: if isOwner(tripId);

      // Members: owners manage roles/removal; you can add or remove *yourself*
      // (self-join via invite, self-leave).
      match /members/{memberId} {
        // The app owner may also read (and list) members for the usage dashboard.
        allow read:   if isMember(tripId) || isAppOwner();
        // Self-join is allowed only as a plain 'member' — you can't make yourself
        // an owner. The one exception is the trip's creator seeding themselves as
        // the initial owner. Existing owners/admins may add anyone in any role.
        allow create: if isSignedIn() && (
                         isOwner(tripId) || isAdmin()
                         || (memberId == uid() && request.resource.data.role == 'member'
                             && joinsWithLiveInvite(tripId, request.resource.data))
                         || (memberId == uid() && request.resource.data.role == 'owner'
                             && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == uid())
                       );
        // Owners/admins manage roles; you may edit your own member doc but NOT
        // change your own role (no self-promotion to owner).
        allow update: if isOwner(tripId) || isAdmin()
                   || (memberId == uid() && request.resource.data.role == resource.data.role);
        allow delete: if memberId == uid() || isOwner(tripId) || isAdmin();
      }

      // Invites: members only. The doc names the owner and everyone who joined
      // (createdBy, usedBy), so outsiders resolve a code through /inviteIndex,
      // which holds just the trip id and expiry.
      match /invites/{code} {
        allow read:   if isMember(tripId);
        // Only the trip's owner (or an app admin) can mint or revoke invites.
        allow create, delete: if isOwner(tripId) || isAdmin();
        // A person who just joined adds themselves to usedBy, and nothing
        // else: a member can't extend an invite's expiry or change its trip.
        allow update: if isMember(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy is list
          && request.resource.data.usedBy.hasAll(resource.data.get('usedBy', []))
          && request.resource.data.usedBy.removeAll(resource.data.get('usedBy', [])).hasOnly([uid()]);
      }

      // Outfit photos: PRIVATE to the uploader. A trip member can read/write
      // only their own photos (doc carries ownerUid); other members and
      // outsiders get nothing. Kept out of the shared {sub}/{doc} allowlist
      // below so this stricter rule is the only grant.
      // Each new photo counts against the uploader's daily allowance, and a
      // photo doc holds only the photo: an inline JPEG or its Storage paths.
      function isPhotoDoc(data) {
        return data.keys().hasOnly(['ownerUid', 'date', 'dataUrl', 'path', 'thumbPath', 'width', 'height'])
          && shortString(data.date, 10)
          && (!('dataUrl' in data) || (data.dataUrl is string && data.dataUrl.matches('^data:image/jpeg;base64,.*')));
      }
      match /outfitPhotos/{photoId} {
        allow read:   if isMember(tripId) && resource.data.ownerUid == uid();
        allow create: if isMember(tripId) && request.resource.data.ownerUid == uid()
                                          && isPhotoDoc(request.resource.data)
                                          && countsAgainstQuota('photos');
        allow update: if isMember(tripId) && resource.data.ownerUid == uid()
                                          && request.resource.data.ownerUid == uid()
                                          && isPhotoDoc(request.resource.data);
        allow delete: if isMember(tripId) && resource.data.ownerUid == uid();
      }

      // Packing lists: PRIVATE to their owner (packing/{uid}), as the privacy
      // policy promises; other members can't read, list or change them. The
      // trip owner may delete one (a removed member's, when the trip is torn
      // down) but never read it.
      // Place lookups for this trip's map (#356): place name → coordinates,
      // shared by the trip's members only. Removed with the trip.
      match /geocache/{docId} {
        allow read, delete: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && request.resource.data.keys().hasOnly(['entries'])
          && request.resource.data.entries is map;
      }

      // What the weather was on a past day (#558), keyed by date: saved once by
      // the first member to load it after it settles (6+ days on), never edited,
      // so everyone sees the same. Members may delete (trip teardown).
      match /weather/{date} {
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])) < request.time - duration.value(5, 'd')
          && request.resource.data.keys().hasOnly(['city', 'minF', 'maxF', 'code', 'savedAt'])
          && request.resource.data.keys().hasAll(['city', 'minF', 'maxF', 'code', 'savedAt'])
          && request.resource.data.city is string && request.resource.data.city.size() <= 100
          && request.resource.data.minF is number && request.resource.data.maxF is number
          && request.resource.data.minF <= request.resource.data.maxF
          && request.resource.data.minF > -100 && request.resource.data.maxF < 150
          && request.resource.data.code is int && request.resource.data.code >= 0 && request.resource.data.code < 100
          && request.resource.data.savedAt == request.time;
        allow update: if false;
      }

      // Finance "paid" ticks, shared with the trip (#448): one record per
      // debt item marked paid (from → to, for one expense), saying who ticked
      // it. Unticking deletes it; a tick is never edited.
      match /payments/{markId} {
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId)
          && request.resource.data.keys().hasOnly(['from', 'to', 'itemId', 'markedBy', 'at'])
          && request.resource.data.markedBy == uid()
          && request.resource.data.at == request.time
          && request.resource.data.from is string && request.resource.data.to is string
          && request.resource.data.itemId is string;
        allow update: if false;
      }

      match /packing/{ownerUid} {
        allow read, write: if isMember(tripId) && ownerUid == uid();
        allow delete:      if isMember(tripId) && (ownerUid == uid() || isOwner(tripId));
      }

      // Collaborative + per-user trip data. Enumerated so the wildcard can't
      // over-grant on the members/invites sub-collections above.
      match /{sub}/{doc} {
        allow read, write: if isMember(tripId) && sub in [
          'itinerary', 'finance', 'stays', 'recs', 'cars', 'pins',
          'flights', 'outfits', 'dayLabels', 'packingSuggestions',
          'activityLog', 'removedMembers', 'events'
        ];
      }
    }

    // Everything else is denied by default (no catch-all allow).
  }
}
