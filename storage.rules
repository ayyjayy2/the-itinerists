rules_version = '2';

// Cloud Storage holds one thing: outfit photos, which are private to the
// person who took them. The owner's uid is the first path segment so the
// grant needs nothing but the token. Everything else in the bucket is closed.
// Tested by test/storage-rules.test.mjs (npm run test:rules).
service firebase.storage {
  match /b/{bucket}/o {

    match /outfitPhotos/{ownerUid}/{tripId}/{file} {
      allow read:   if request.auth != null && request.auth.uid == ownerUid;
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
      allow write:  if request.auth != null && request.auth.uid == ownerUid
                    && request.resource.contentType == 'image/jpeg'
                    && request.resource.size <= 4 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
