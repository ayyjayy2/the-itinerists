FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Optional — Firebase App Check (reCAPTCHA v3). Leave BLANK to disable (default).
# To enable: Firebase Console → App Check → register this web app with the
# reCAPTCHA v3 provider, paste the site key here, then re-run `npm run gen-env`.
RECAPTCHA_SITE_KEY=

