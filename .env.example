FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Optional — Firebase App Check (reCAPTCHA v3). Leave BLANK to disable (default).
# To enable: Firebase Console → App Check → register this web app with the
# reCAPTCHA v3 provider, paste the site key here, then re-run `npm run gen-env`.
RECAPTCHA_SITE_KEY=

# Optional — fixed App Check debug token so localhost passes attestation when
# App Check enforcement is on. Generate a UUID, register it in Firebase Console
# → App Check → Apps → (web app) ⋮ → Manage debug tokens, paste it here, then
# re-run `npm run gen-env`. Leave BLANK to have the SDK generate a random
# per-browser token instead (printed to the browser console; register it the
# same way). Dev builds only — never included in the prod bundle.
APPCHECK_DEBUG_TOKEN=

# Seed admin account used by scripts/seed-admin.js and seed-admin-client.mjs.
# Pick a strong password; never commit the real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

